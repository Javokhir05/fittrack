DATABASE_URL=postgresql://postgres:Javokhir2346@localhost:5432/fittrack
JWT_SECRET=Javahere
# Sessions: short-lived access token + rotating refresh token (httpOnly cookies)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Same-origin (local dev, docker-compose/nginx): strict. If the frontend and API are on
# DIFFERENT domains (e.g. two Railway services) use: COOKIE_SAMESITE=none
COOKIE_SAMESITE=strict
# Defaults to true in production. Set false only for plain-http local testing.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (Railway/nginx = 1). Defaults to 1 in production.
# TRUST_PROXY=1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
